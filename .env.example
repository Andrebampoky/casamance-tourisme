# Copier vers .env pour Docker Compose. Remplacer les secrets avant toute exposition réseau.
POSTGRES_DB=casamance
POSTGRES_USER=casamance
DB_PASSWORD=change-moi-localement
RESERVATION_DB_NAME=casamance
TOURISM_DB_NAME=casamance_experience
NOTIFICATION_DB_NAME=casamance_notifications
RESERVATION_ADMIN_TOKEN=change-moi-token-admin

API_PORT=8081
WEB_PORT=4201
DB_PORT=5432
APP_PUBLIC_URL=http://localhost:8081
APP_FRONTEND_URL=http://localhost:4201

# SMTP facultatif. Vide = notifications conservées dans l'outbox.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@casamance.local
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_DISPATCH_INTERVAL_MS=30000
